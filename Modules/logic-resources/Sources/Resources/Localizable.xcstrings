    "onboarding_token_qr_intro_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Ihre Identität vor Ort verifiziert haben, erhalten Sie möglicherweise ein Token oder einen QR-Code. Tippen Sie auf „Scannen“ und scannen Sie den QR-Code, um die Registrierung zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you verified your identity on-site, you may receive a token or QR code. Tap Scan and scan the QR code to start the enrollment."
          }
        }
      }
    },
    "onboarding_token_qr_intro_title": {
      "extractionState": "manual",
