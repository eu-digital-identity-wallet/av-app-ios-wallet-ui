        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Ihren Fingerabdruck oder die Gesichtserkennung, um sich bei der App „%@“ anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your fingerprint or face recognition to log in to the “%@” app."
