    "landing_screen_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan dele dit aldersbevis med tjenester, der er begrænset til voksne.\\nAldersbeviset bekræfter kun, at du er over 18 år. Det indeholder ingen andre personlige oplysninger."
          }
