        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie bitte Ihre PIN ein, um auf die Altersverifizierungs-Wallet zuzugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To access the Age Verification Application, please enter your PIN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour accéder au portefeuille de vérification d'âge, veuillez saisir votre code PIN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
