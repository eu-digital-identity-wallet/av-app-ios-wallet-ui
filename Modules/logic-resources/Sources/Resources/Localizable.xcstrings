    "issuance_document_offer_error_invalid_txcode_format": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyldigt transaktionskodeformat. Længden skal være mellem %1$d og %2$d cifre, og kun numeriske tegn er tilladt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültiges Transaktionscodeformat. Die Länge sollte zwischen %1$d und %2$d Ziffern liegen. Es sind nur numerische Zeichen zulässig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid transaction code format. Length should be between %1$d to %2$d digits and only numeric characters are allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de code de transaction non valide. La longueur doit être entre %1$d et %2$d chiffres et seuls les caractères numériques sont autorisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato del codice di transazione non valido. La lunghezza deve essere compresa tra %1$d e %2$d cifre. Sono consentiti solo caratteri numerici."
          }
        }
      }
    },
