    "unsupported_device_message": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din enhed opfylder ikke sikkerhedskravene til denne app: der er ikke indstillet en adgangskode. Aktivér venligst en adgangskode i Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Gerät erfüllt nicht die Sicherheitsanforderungen dieser App: Es ist kein Passcode festgelegt. Bitte aktivieren Sie einen Passcode in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device doesn't meet the security requirements for this app: no passcode is set. Please enable a passcode in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil ne répond pas aux exigences de sécurité de cette application : aucun code n'est défini. Veuillez activer un code dans les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo dispositivo non soddisfa i requisiti di sicurezza di questa app: non è impostato alcun codice. Abilita un codice in Impostazioni."
          }
        }
      }
    },
