    "biometric_login_biometrics_enabled_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug din biometri for at få adgang til applikationen for aldersverifikationen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Ihre Biometriedaten, um auf die Altersverifizierungs-Wallet zuzugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your biometrics to access the Age Verification Application."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre biométrie pour accéder au portefeuille de vérification d'âge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i tuoi dati biometrici per accedere all'applicazione di verifica dell'età."
          }
        }
      }
    },
    "biometric_login_biometrics_not_enabled_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skal indtaste din PIN for at få adgang til applikationen for aldersverifikationen."
