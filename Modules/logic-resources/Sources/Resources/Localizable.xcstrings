    "change_pin_help_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undgå venligst at bruge fortløbende tal eller fødselsdage, hvis det er muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte vermeiden Sie nach Möglichkeit die Verwendung von fortlaufenden Zahlen oder Geburtstagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please avoid using consecutive numbers or birthdays if possible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez éviter d'utiliser des numéros consécutifs ou des anniversaires si possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se possibile, evita di usare numeri consecutivi o date di nascita."
          }
        }
      }
    },
