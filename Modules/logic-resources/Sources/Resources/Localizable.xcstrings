    "request_bottom_sheet_warning_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du vælger ikke at dele visse data, kan det resultere i manglende udstedelse af det anmodede dokument."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie bestimmte Daten nicht teilen, kann das angeforderte Dokument möglicherweise nicht ausgestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choosing not to share certain data may result in failure to issue the requested document."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La décision de ne pas communiquer certaines données peut entraîner la non-délivrance du document demandé."
