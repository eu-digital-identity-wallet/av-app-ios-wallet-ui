    "passport_identification_description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For dette trin skal du tage MRZ-området (maskinlæsbar zone) nederst på fotosiden af dit pas / ID-kort. Sørg for:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Schritt erfassen Sie den MRZ-Bereich (maschinenlesbare Zone) am unteren Rand der Fotoseite Ihres Reisepasses / Personalausweises. Stellen Sie sicher:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this step, capture the MRZ (Machine Readable Zone) area at the bottom of your passport / ID card photo page. Make sure:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour cette étape, capturez la zone MRZ (zone de lecture automatique) en bas de la page photo de votre passeport / carte d\\'identité. Assurez-vous :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per questo passaggio, cattura l\\'area MRZ (zona leggibile dalla macchina) nella parte inferiore della pagina foto del tuo passaporto / carta d\\'identità. Assicurati che:"
          }
        }
      }
    },
    "passport_identification_footer": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi tager en identifikationskode fra dette pas / ID-kort for at få adgang til den maskinlæsbare del af dokumentet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir nehmen einen Identifikationscode von diesem Reisepass / Personalausweis, um Zugang zum maschinenlesbaren Teil des Dokuments zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We take an identification code from this passport / ID card to get access to the machine readable part of the document."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous prenons un code d\\'identification de ce passeport / carte d\\'identité pour accéder à la partie lisible par machine du document."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendiamo un codice identificativo da questo passaporto / carta d\\'identità per accedere alla parte leggibile dalla macchina del documento."
          }
        }
      }
    },
