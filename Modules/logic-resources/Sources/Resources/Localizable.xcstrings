    "request_data_verified_entity_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relying party is considered trusted when it meets predefined criteria for security, data protection, compliance, and responsible data handling. Trust is reinforced through assessments, audits, and certifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vertrauende Partei gilt als vertrauenswürdig, wenn sie vordefinierte Kriterien für Sicherheit, Datenschutz, Compliance und verantwortlichen Datenumgang erfüllt. Das Vertrauen wird durch Bewertungen, Audits und Zertifizierungen gestärkt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte affidante è considerata affidabile quando soddisfa criteri predefiniti di sicurezza, protezione dei dati, conformità e gestione responsabile dei dati. La fiducia viene rafforzata attraverso valutazioni, audit e certificazioni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En afhængig part anses for at være betroet, når den opfylder foruddefinerede kriterier for sikkerhed, databeskyttelse, compliance og ansvarlig datahåndtering. Tillid styrkes gennem vurderinger, revisioner og certificeringer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de confiance est considérée comme digne de confiance lorsqu&#39;elle répond à des critères prédéfinis en matière de sécurité, de protection des données, de conformité et de gestion responsable des données. La confiance est renforcée par des évaluations, des audits et des certifications."
          }
        }
      }
    },
