    "onboarding_verification_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne verifikation er nødvendig for at skabe et bevis på, at du er over 18 år. eID -detaljerne vil ikke blive delt med onlinetjenester, du får adgang til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verifikation ist erforderlich, um einen Nachweis zu erstellen, dass Sie über 18 Jahre alt sind. Die eID-Details werden nicht mit Online-Diensten geteilt, auf die Sie zugreifen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This verification is needed to create a proof that you are over 18. The eID details will not be shared with online services you access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette vérification est nécessaire pour créer une preuve que vous avez plus de 18 ans. Les détails de l'eID ne seront pas communiqués aux services en ligne auxquels vous accédez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa verifica è necessaria per creare un'attestazione che dimostri che hai più di 18 anni. I dettagli eID non saranno condivisi con i servizi online a cui accedi."
          }
        }
      }
    },
    "onboarding_verification_national_id" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
