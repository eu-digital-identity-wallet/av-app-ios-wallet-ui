          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilisation de cette application vous permet de prouver en toute securité que vous avez plus de 18 ans lors d'accès aux services limités aux adultes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzando quest'app, puoi dimostrare in modo sicuro di avere almeno 18 anni quando accedi ai servizi riservati agli adulti."
          }
        }
      }
    },
    "welcome_page_2" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificér din alder én gang og brug dette bevis til sikker adgang til mange tjenester, der er begrænset til voksne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify that you are over 18 once, use this proof to securely access many services restricted to adults."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirmez une seule fois que vous avez plus de 18 ans, puis utilisez cette preuve pour accéder en toute securité à de nombreux services réservés aux adultes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica di avere almeno 18 anni, e usa questa attestazione per accedere in modo sicuro a molti servizi riservati agli adulti."
          }
        }
      }
    },
    "welcome_page_3" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bevarer kontrollen over dine data: Det er kun beviset for, at du er over 18 år, som deles. Ingen andre personlige oplysninger gemmes eller deles med onlinetjenester."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You stay in control of your data: only the proof that you are over 18 is shared. No other personal details are stored or shared with online services."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous gardez le contrôle de vos données : seulement la preuve que vous avez plus de 18 ans est communiquée. Aucun autre détail personnel n'est enregistré ou communiqué à des services en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il controllo dei tuoi dati: solo l'attestazione della tua maggiore età verrà condivisa. Nessun altro dettaglio personale sarà archiviato o condiviso con i servizi online."
          }
        }
      }
    },
