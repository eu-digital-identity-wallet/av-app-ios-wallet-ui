    "change_quick_pin_caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast venligst din nuværende pinkode. Når du har bekræftet den, kan du indstille en ny pinkode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte geben Sie Ihre aktuelle PIN ein. Nach der Bestätigung können Sie eine neue PIN festlegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please enter your current PIN. After confirming it, you can set a new PIN."
          }
        },
        "fr" : {
