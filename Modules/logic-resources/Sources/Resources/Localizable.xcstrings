    "passport_scan_intro_data_download_notice": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikation kræver yderligere data. Når du trykker på Start, downloades ca. 250MB til ansigtsmatching."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifizierung erfordert zusätzliche Daten. Wenn Sie auf Starten tippen, werden ca. 250MB an Dateien für den Gesichtsabgleich heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification requires additional data. When you tap Start, approximately 250MB of assets will be downloaded for face matching."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification nécessite des données supplémentaires. Lorsque vous appuyez sur Commencer, environ 250MB d\\'éléments seront téléchargés pour la reconnaissance faciale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica richiede dati aggiuntivi. Quando tocchi Inizia, verranno scaricati circa 250MB di risorse per il riconoscimento facciale."
          }
        }
      }
    },
    "passport_scan_intro_description": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas / ID-kort metoden er hurtig og sikker! Tag et billede af dit pas / ID-kort, scan dit pas / ID-kort og optag en video af dig selv—tre trin for sikker onboarding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Reisepass / Personalausweis Methode ist schnell und sicher! Foto Ihres Reisepasses / Personalausweises aufnehmen, Reisepass / Personalausweis scannen und Video von sich selbst aufnehmen—drei Schritte für sicheres Onboarding."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passport / ID card method is quick and secure! Take a photo of your passport / ID card, scan your passport / ID card, and record a video of yourself—three steps for secure onboarding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La méthode passeport / carte d\\'identité est rapide et sécurisée ! Prendre une photo de votre passeport / carte d\\'identité, scannez votre passeport / carte d\\'identité et enregistrer une vidéo de vous-même—trois étapes pour un onboarding sécurisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il metodo passaporto / carta d\\'identità è veloce e sicuro! Scatta una foto del tuo passaporto / carta d\\'identità, scansiona il tuo passaporto / carta d\\'identità e registra un video di te stesso—tre passaggi per un onboarding sicuro."
          }
        }
      }
    },
