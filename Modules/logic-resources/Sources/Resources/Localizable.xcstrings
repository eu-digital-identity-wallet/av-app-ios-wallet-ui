    "landing_screen_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan dele dit aldersbevis med tjenester, der er begrænset til voksne.\\nAldersbeviset bekræfter kun, at du er over 18 år. Det indeholder ingen andre personlige oplysninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können Ihren Altersnachweis mit Diensten teilen, die auf Erwachsene beschränkt sind. Dieser Nachweis bestätigt, dass Sie über 18 Jahre alt sind, ohne andere persönliche Informationen preiszugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can share your proof of age with services restricted to adults. This proof confirms that you are over 18 without revealing any other personal information."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez communiquer votre preuve d'âge aux services limités aux adultes. Cette preuve confirme que vous avez plus de 18 ans sans révéler aucune autre information personnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi condividere la tua attestazione dell'età con i servizi riservati agli adulti. Questo documento conferma che hai almeno 18 anni senza rivelare altre informazioni personali."
          }
        }
      }
    },
