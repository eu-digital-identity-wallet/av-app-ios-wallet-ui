    "warning_authentication_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication has failed! Please try to scan the document again or introduce the data manually."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung fehlgeschlagen! Bitte versuchen Sie, das Dokument erneut zu scannen oder die Daten manuell einzugeben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticazione non riuscita! Prova a scansionare di nuovo il documento o inserisci i dati manualmente."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelse mislykkedes! Prøv at scanne dokumentet igen, eller indtast dataene manuelt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification a échoué! Veuillez essayer de scanner à nouveau le document ou saisir les données manuellement."
          }
        }
      }
    },
